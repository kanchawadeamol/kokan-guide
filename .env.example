# -----------------------------------------------------------------------------
# Konkan Discovery Platform: example environment configuration
# Copy to `.env` and fill in values. NEVER commit `.env`.
# Values here are placeholders for LOCAL DEVELOPMENT ONLY.
# Keep comments on their own lines: inline comments are parsed inconsistently.
# -----------------------------------------------------------------------------

# ---- General ----
# development | test | staging | production
APP_ENV=development
LOG_LEVEL=INFO

# ---- PostgreSQL + PostGIS ----
POSTGRES_DB=konkan
# Schema owner: used by Alembic migrations only
POSTGRES_USER=konkan_owner
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Least-privilege runtime role used by the API (DML only, no DDL)
DB_APP_USER=konkan_app
DB_APP_PASSWORD=change-me-local-only

# ---- Redis (optional: rate limiting / caching) ----
REDIS_URL=redis://redis:6379/0

# ---- Backend API ----
API_HOST=0.0.0.0
API_PORT=8000
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14
# Comma-separated list of allowed browser origins (no wildcards)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- AI provider (backend only: never expose to web/mobile) ----
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
AI_DAILY_REQUEST_LIMIT_PER_USER=50
# 0 disables AI calls until a budget is explicitly set
AI_MONTHLY_BUDGET_USD=0

# ---- File uploads ----
UPLOAD_MAX_BYTES=5242880
# local | s3 (future)
UPLOAD_STORAGE=local

# ---- Public client config (URLs only, never secrets) ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
