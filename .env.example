# -----------------------------------------------------------------------------
# Konkan Discovery Platform: example environment configuration
# Copy to `.env` and fill in values. NEVER commit `.env`.
# Values here are placeholders for LOCAL DEVELOPMENT ONLY.
# Keep comments on their own lines: inline comments are parsed inconsistently.
# -----------------------------------------------------------------------------

# ---- General ----
# development | test | staging | production
APP_ENV=development
LOG_LEVEL=INFO

# ---- PostgreSQL + PostGIS ----
# Three roles (created on first DB start by infrastructure/docker/postgres/initdb/20-roles.sh):
#   POSTGRES_USER     bootstrap superuser: init/admin only, never given to the API
#   DB_MIGRATOR_USER  owns schema objects; used only by Alembic migrations
#   DB_APP_USER       API runtime role: SELECT/INSERT/UPDATE/DELETE only
# Generate passwords with: python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_DB=konkan
POSTGRES_USER=konkan_superuser
POSTGRES_PASSWORD=change-me
DB_MIGRATOR_USER=konkan_migrator
DB_MIGRATOR_PASSWORD=change-me
DB_APP_USER=konkan_app
DB_APP_PASSWORD=change-me
# Host-side connection for tools/tests running outside Docker. Use 127.0.0.1, not
# "localhost": on Windows, localhost tries IPv6 first and each refused attempt costs ~2s.
# Inside Compose, services always use host "db" and port 5432.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Host ports published by compose.override.yaml (bound to 127.0.0.1 only)
POSTGRES_HOST_PORT=5432
API_HOST_PORT=8000

# ---- Redis (optional: rate limiting / caching) ----
REDIS_URL=redis://redis:6379/0

# ---- Backend API ----
API_HOST=0.0.0.0
API_PORT=8000
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14
# Comma-separated list of allowed browser origins (no wildcards)
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://127.0.0.1:5173,http://localhost:3000,http://localhost:5173

# ---- AI provider (backend only: never expose to web/mobile) ----
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
AI_DAILY_REQUEST_LIMIT_PER_USER=50
# 0 disables AI calls until a budget is explicitly set
AI_MONTHLY_BUDGET_USD=0

# ---- File uploads ----
UPLOAD_MAX_BYTES=5242880
# local | s3 (future)
UPLOAD_STORAGE=local

# ---- Public client config (URLs only, never secrets) ----
# API origin only: request paths already include /api/v1.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
VITE_API_URL=http://127.0.0.1:8000
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000

# ---- Public website (server-only; set in shell/CI/deployment, Next.js does not read this file) ----
# Public origin for canonical URLs, hreflang and sitemap. Required for production builds.
SITE_URL=http://127.0.0.1:3000
