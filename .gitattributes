# Normalise line endings: LF in the repo for all text files.
# Prevents CRLF breakage in shell scripts and Docker entrypoints on Windows.
* text=auto eol=lf

*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.gif  binary
*.ico  binary
*.ttf  binary
*.otf  binary
*.woff binary
*.woff2 binary
*.jar  binary
