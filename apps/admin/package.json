{
  "name": "@konkan/admin",
  "version": "0.0.0",
  "private": true,
  "description": "Admin dashboard for the Konkan Discovery Platform.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
