{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "allowJs": false,
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "noPropertyAccessFromIndexSignature": false
  },
  "include": ["next-env.d.ts", "src", ".next/types/**/*.ts", "*.ts", "e2e"],
  "exclude": ["node_modules", ".next"]
}
