{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "admin",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "-w", "apps/admin"],
      "port": 5173,
      "url": "http://127.0.0.1:5173"
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "-w", "apps/web"],
      "port": 3000,
      "url": "http://127.0.0.1:3000"
    },
    {
      "name": "mobile-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "web", "-w", "apps/mobile", "--", "--port", "8081"],
      "port": 8081,
      "url": "http://localhost:8081"
    }
  ]
}
