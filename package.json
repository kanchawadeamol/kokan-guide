{
  "name": "konkan-discovery",
  "version": "0.0.0",
  "private": true,
  "description": "Regional discovery platform for Ratnagiri and Raigad districts (Konkan, Maharashtra).",
  "license": "UNLICENSED",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "packageManager": "npm@11.6.2",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "api:generate": "node scripts/generate-api-client.mjs",
    "api:check": "node scripts/generate-api-client.mjs --check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "minimatch@>=7.0.0 <11.0.1": "11.0.9",
    "glob@>=9.0.0 <=14.0.1": "14.0.6"
  }
}
